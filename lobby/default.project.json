      },
      "Kit": {
        "$className": "Folder",
        "UI": {
          "$path": "../../../shared/UI"
        },
        "Lib": {
          "$path": "../../../shared/Lib"
        }
      },
      "Common": {
        "$path": "../common"
      },
      "Remotes": {
        "$className": "Folder",
        "Notice": {
          "$className": "RemoteEvent"
        },
        "SessionState": {
          "$className": "RemoteEvent"
        },
